#URL
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=94XXXXXXXXX

# Google OAuth 2.0 web client ID (Google Cloud Console > APIs & Services > Credentials).
# Must match GOOGLE_CLIENT_ID in tutorme-api's .env — same value, safe to expose client-side.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Cloud Translation API key (required for Sinhala/Tamil translation of backend data)
# Get one from https://console.cloud.google.com/apis/credentials
# Enable "Cloud Translation API" in your project first.
# Free tier: 500,000 characters / month.  Leave blank to disable translation.
GOOGLE_TRANSLATE_API_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_ENABLE_SENTRY_TEST_LOGGER=false
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=
